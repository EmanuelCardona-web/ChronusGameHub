# ------------------------------------------------------------------
# Chronos Gaming Hub & Cloud Services - Variables de entorno
# Copia este archivo como ".env" y completa con tus credenciales reales.
# NUNCA subas el archivo ".env" real al repositorio.
# ------------------------------------------------------------------

# --- Flask ---
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# true solo en desarrollo local. Nunca en producción.
FLASK_DEBUG=false
# true en producción (HTTPS): la cookie de sesión solo viaja cifrada.
SESSION_COOKIE_SECURE=false

# --- Base de datos: Supabase (PostgreSQL) ---
# Si la contraseña tiene caracteres especiales, codifícala para URL.
DATABASE_URL=postgresql+pg8000://USUARIO:CONTRASENA@HOST:5432/postgres

# --- Auth0: aplicación "Regular Web Application" (login y registro) ---
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=http://localhost:5000/auth/callback

# --- Auth0: aplicación "Machine to Machine" (Management API v2) ---
# Scopes requeridos: read:users, update:users
AUTH0_AUDIENCE=https://tu-tenant.us.auth0.com/api/v2/
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# --- Autorización ---
# Claim que agrega la Auth0 Action "Agregar roles al token".
AUTH0_ROLES_CLAIM=https://chronosgaminghub/roles
ADMIN_ROLE=admin
# Opcional (arranque): correos verificados con acceso admin, separados por coma.
ADMIN_EMAILS=
